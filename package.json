{
  "name": "interndash-backend",
  "version": "1.0.0",
  "description": "InternDash 实习管理平台后端",
  "main": "app.js",
  "scripts": {
    "start":   "node app.js",
    "dev":     "nodemon app.js",
    "scraper": "python3 scraper.py",
    "scraper:real": "python3 scraper.py --real --dynamic",
    "scraper:watch": "python3 scraper.py --real --dynamic --loop --interval 30"
  },
  "dependencies": {
    "cors":      "^2.8.5",
    "dotenv":    "^16.4.5",
    "express":   "^4.19.2",
    "mongoose":  "^8.4.1",
    "morgan":    "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
